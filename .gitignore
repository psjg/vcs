# Block-first policy: .git/info/exclude ignores '*', so tracking is opt-in.
# Negations here take precedence over info/exclude. Add a line per thing we
# deliberately want under version control.
!/.gitignore
!/.envrc
!/HANDOFF.md
!/LICENSE
!/bin/
!/bin/**
!/.githooks/
!/.githooks/**
!/.gitmessage
!/v0/
!/v0/**
!/shelved/
!/shelved/**
!/theory/
!/theory/**

# ...and re-ignore build output, which the blanket negation above would catch.
/v0/target/
/theory/tla/states/
/theory/tla/*.log
/theory/agda/_build/
/theory/agda/*.agdai
/theory/alloy/Capabilities/
/theory/alloy/Contraction/
/theory/lean/*.olean
/theory/lean/*.ilean
/theory/.lake/
/theory/V1/
/theory/V1.lean
/theory/tla/
/theory/alloy/
/theory/agda/
/theory/flake.nix
/theory/flake.lock
/theory/lakefile.toml
/theory/lake-manifest.json
/theory/lean-toolchain
/theory/Makefile
/theory/*.tex
/theory/*.pdf
/theory/alloy/out/
/theory/.agree/
