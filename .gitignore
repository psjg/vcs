# Block-first policy: .git/info/exclude ignores '*', so tracking is opt-in.
# Negations here take precedence over info/exclude. Add a line per thing we
# deliberately want under version control.
!/.gitignore
!/.envrc
!/HANDOFF.md
!/LICENSE
!/bin/
!/bin/**
!/.githooks/
!/.githooks/**
!/.gitmessage
!/v0/
!/v0/**
!/shelved/
!/shelved/**
!/v1/
!/v1/**

# ...and re-ignore build output, which the blanket negation above would catch.
/v0/target/
/v1/tla/states/
/v1/tla/*.log
/v1/agda/_build/
/v1/agda/*.agdai
/v1/alloy/Capabilities/
/v1/alloy/Contraction/
/v1/lean/*.olean
/v1/lean/*.ilean
/v1/theory/.lake/
/v1/theory/V1/
/v1/theory/V1.lean
/v1/theory/tla/
/v1/theory/alloy/
/v1/theory/agda/
/v1/theory/flake.nix
/v1/theory/flake.lock
/v1/theory/lakefile.toml
/v1/theory/lake-manifest.json
/v1/theory/lean-toolchain
/v1/theory/Makefile
/v1/theory/*.tex
/v1/theory/*.pdf
